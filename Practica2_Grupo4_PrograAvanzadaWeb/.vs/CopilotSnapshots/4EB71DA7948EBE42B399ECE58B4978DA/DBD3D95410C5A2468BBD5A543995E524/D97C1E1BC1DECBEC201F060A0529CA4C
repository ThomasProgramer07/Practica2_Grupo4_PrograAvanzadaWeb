@* Views/Categoria/Index.cshtml *@
@model List<Practica2_Grupo4_PrograAvanzadaWeb.BLL.Dtos.CategoriaDto>
@{
    ViewData["Title"] = "Categorías";
}

<h1>Categorías de Productos Médicos</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#modalCrearCategoria">
    Nueva Categoría
</button>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Nombre</td>
                <td>@categoria.Descripcion</td>
                <td class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-sm btn-warning btn-editar-categoria"
                            data-bs-toggle="modal"
                            data-bs-target="#modalEditarCategoria"
                            data-id="@categoria.Id"
                            data-nombre="@categoria.Nombre"
                            data-descripcion="@categoria.Descripcion">
                        Editar
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-danger btn-eliminar-categoria"
                            data-bs-toggle="modal"
                            data-bs-target="#modalConfirmarEliminarCategoria"
                            data-id="@categoria.Id"
                            data-nombre="@categoria.Nombre">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Crear" model="new Practica2_Grupo4_PrograAvanzadaWeb.BLL.Dtos.CategoriaDto()" />
<partial name="_Editar" model="new Practica2_Grupo4_PrograAvanzadaWeb.BLL.Dtos.CategoriaDto()" />

<div class="modal fade" id="modalConfirmarEliminarCategoria" tabindex="-1" aria-labelledby="labelModalConfirmarEliminarCategoria" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="labelModalConfirmarEliminarCategoria">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Desea eliminar la categoría <strong id="nombreCategoriaAEliminar"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form asp-action="DeleteCategoria" asp-controller="Categoria" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idCategoriaAEliminar" name="id" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.btn-editar-categoria').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('IdEditar').value = this.dataset.id || '';
                document.getElementById('NombreEditar').value = this.dataset.nombre || '';
                document.getElementById('DescripcionEditar').value = this.dataset.descripcion || '';
            });
        });

        document.querySelectorAll('.btn-eliminar-categoria').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('idCategoriaAEliminar').value = this.dataset.id || '';
                document.getElementById('nombreCategoriaAEliminar').textContent = this.dataset.nombre || '';
            });
        });
    </script>
}