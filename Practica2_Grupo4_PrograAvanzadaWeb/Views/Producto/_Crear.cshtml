@model Practica2_Grupo4_PrograAvanzadaWeb.BLL.Dtos.ProductoDto

<div class="modal fade" id="modalCrearProducto" tabindex="-1" aria-labelledby="labelModalCrearProducto" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header text-white" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);">
                <h5 class="modal-title fw-semibold" id="labelModalCrearProducto">
                    <i class="bi bi-box-seam-fill me-2"></i>Nuevo Producto Médico
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="formCrearProducto" asp-action="CreateProducto" asp-controller="Producto" method="post" class="row g-3">
                    @Html.AntiForgeryToken()

                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-medium">
                            <i class="bi bi-tag text-primary me-1"></i>Nombre
                        </label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Acetaminofén 500mg" id="NombreCrear" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FkCategoria" class="form-label fw-medium">
                            <i class="bi bi-grid text-primary me-1"></i>Categoría
                        </label>
                        <select asp-for="FkCategoria" asp-items="ViewBag.Categorias" class="form-select" id="FkCategoriaCrear">
                            <option value="">-- Seleccione una categoría --</option>
                        </select>
                        <span asp-validation-for="FkCategoria" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label fw-medium">
                            <i class="bi bi-card-text text-primary me-1"></i>Descripción
                        </label>
                        <input asp-for="Descripcion" class="form-control" placeholder="Descripción breve del producto" id="DescripcionCrear" />
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Precio" class="form-label fw-medium">
                            <i class="bi bi-currency-dollar text-primary me-1"></i>Precio
                        </label>
                        <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" id="PrecioCrear" />
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Cantidad" class="form-label fw-medium">
                            <i class="bi bi-hash text-primary me-1"></i>Cantidad
                        </label>
                        <input asp-for="Cantidad" type="number" class="form-control" placeholder="0" id="CantidadCrear" />
                        <span asp-validation-for="Cantidad" class="text-danger small"></span>
                    </div>

                </form>
            </div>

            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cerrar
                </button>
                <button type="submit" class="btn btn-primary" form="formCrearProducto" id="btnGuardarProducto">
                    <i class="bi bi-floppy me-1"></i>Guardar
                </button>
            </div>

        </div>
    </div>
</div>