@* Views/Producto/Index.cshtml *@
@model List<Practica2_Grupo4_PrograAvanzadaWeb.BLL.Dtos.ProductoDto>
@{
    ViewData["Title"] = "Productos";
}

<h1>Productos Médicos</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Producto</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th>Categoría</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Nombre</td>
                <td>@producto.Descripcion</td>
                <td>₡@producto.Precio.ToString("N2")</td>
                <td>@producto.Cantidad</td>
                <td>@producto.NombreCategoria</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>